{
  "$schema": "./catalog.schema.json",
  "version": 1,
  "placeholderSyntax": "{{field_key}}",
  "templates": [
    {
      "id": "mutual-nda",
      "name": "Mutual Non-Disclosure Agreement",
      "category": "confidentiality",
      "description": "Two-way NDA for parties that will both share confidential information, e.g. when exploring a partnership.",
      "file": "mutual-nda.md",
      "format": "markdown",
      "jurisdiction": "generic",
      "fields": [
        {
          "key": "effective_date",
          "label": "Effective date",
          "type": "date",
          "required": true
        },
        {
          "key": "party_a_name",
          "label": "Party A legal name",
          "type": "text",
          "required": true
        },
        {
          "key": "party_a_entity_type",
          "label": "Party A entity type",
          "type": "text",
          "required": true,
          "example": "Delaware corporation"
        },
        {
          "key": "party_a_address",
          "label": "Party A address",
          "type": "address",
          "required": true
        },
        {
          "key": "party_a_signatory_name",
          "label": "Party A signatory name",
          "type": "text",
          "required": true
        },
        {
          "key": "party_a_signatory_title",
          "label": "Party A signatory title",
          "type": "text",
          "required": true
        },
        {
          "key": "party_b_name",
          "label": "Party B legal name",
          "type": "text",
          "required": true
        },
        {
          "key": "party_b_entity_type",
          "label": "Party B entity type",
          "type": "text",
          "required": true,
          "example": "Delaware corporation"
        },
        {
          "key": "party_b_address",
          "label": "Party B address",
          "type": "address",
          "required": true
        },
        {
          "key": "party_b_signatory_name",
          "label": "Party B signatory name",
          "type": "text",
          "required": true
        },
        {
          "key": "party_b_signatory_title",
          "label": "Party B signatory title",
          "type": "text",
          "required": true
        },
        {
          "key": "purpose",
          "label": "Purpose of disclosure",
          "type": "textarea",
          "required": true,
          "example": "evaluating a potential business partnership"
        },
        {
          "key": "term_years",
          "label": "Agreement term (years)",
          "type": "integer",
          "required": true,
          "default": 2
        },
        {
          "key": "confidentiality_period_years",
          "label": "Confidentiality period (years)",
          "type": "integer",
          "required": true,
          "default": 3
        },
        {
          "key": "governing_law",
          "label": "Governing law (state / country)",
          "type": "text",
          "required": true,
          "example": "the State of New York"
        },
        {
          "key": "jurisdiction",
          "label": "Courts with jurisdiction",
          "type": "text",
          "required": true,
          "example": "New York County, New York"
        }
      ]
    },
    {
      "id": "unilateral-nda",
      "name": "Unilateral Non-Disclosure Agreement",
      "category": "confidentiality",
      "description": "One-way NDA where only one party discloses confidential information to the other.",
      "file": "unilateral-nda.md",
      "format": "markdown",
      "jurisdiction": "generic",
      "fields": [
        {
          "key": "effective_date",
          "label": "Effective date",
          "type": "date",
          "required": true
