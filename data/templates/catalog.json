          "required": true
        },
        {
          "key": "discloser_signatory_name",
          "label": "Disclosing party signatory name",
          "type": "text",
          "required": true
        },
        {
          "key": "recipient_name",
          "label": "Receiving party legal name",
          "type": "text",
          "required": true
        },
        {
          "key": "recipient_address",
          "label": "Receiving party address",
          "type": "address",
          "required": true
        },
        {
          "key": "recipient_signatory_name",
          "label": "Receiving party signatory name",
          "type": "text",
          "required": true
        },
        {
          "key": "purpose",
          "label": "Purpose of disclosure",
          "type": "textarea",
          "required": true,
          "example": "evaluating a potential business partnership"
        },
        {
          "key": "confidentiality_period_years",
          "label": "Confidentiality period (years)",
          "type": "integer",
          "required": true,
          "default": 3
        },
        {
          "key": "governing_law",
          "label": "Governing law (state / country)",
          "type": "text",
          "required": true,
          "example": "the State of New York"
        }
      ]
    },
    {
      "id": "independent-contractor-agreement",
