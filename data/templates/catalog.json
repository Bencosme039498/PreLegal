        {
          "key": "compensation",
          "label": "Compensation",
          "type": "text",
          "required": true,
          "example": "$75 per hour"
        },
        {
          "key": "invoice_frequency",
          "label": "Invoice frequency",
          "type": "select",
          "required": true,
          "options": [
            "weekly",
            "bi-weekly",
            "monthly",
            "upon completion"
          ],
          "default": "monthly"
        },
        {
          "key": "payment_terms_days",
          "label": "Payment terms (days)",
          "type": "integer",
          "required": true,
          "default": 30
        },
        {
          "key": "termination_notice_days",
          "label": "Termination notice (days)",
          "type": "integer",
          "required": true,
