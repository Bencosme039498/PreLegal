{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreLegal template catalog",
  "type": "object",
  "required": ["version", "placeholderSyntax", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "placeholderSyntax": { "type": "string" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "description", "file", "format", "jurisdiction", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "category": {
            "enum": ["confidentiality", "services", "employment", "intellectual-property", "finance", "disputes"]
          },
          "description": { "type": "string" },
          "file": { "type": "string", "pattern": "\\.md$" },
          "format": { "const": "markdown" },
          "jurisdiction": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "label", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "label": { "type": "string" },
                "type": {
                  "enum": ["text", "textarea", "address", "date", "integer", "money", "percent", "select"]
                },
                "required": { "type": "boolean" },
                "default": {},
                "example": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            }
          }
        }
      }
    }
  }
}
